// Copy this file to "secrets.h" and fill in your own values.
// secrets.h is git-ignored so credentials never leave your machine.
#pragma once

#define WIFI_SSID          "your-wifi-ssid"
#define WIFI_PASSWORD      "your-wifi-password"

// LAN address of the machine running the FastAPI server (server/main.py).
// Use the PC's IPv4 address, not "localhost" - the ESP32 resolves this itself.
#define SERVER_UPLOAD_URL  "http://192.168.1.X:8000/api/analyze"
